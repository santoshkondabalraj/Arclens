# Google / Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=yt-rag-hybrid
PINECONE_ENVIRONMENT=us-east-1-aws

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=yt-rag

# Anthropic (Claude Opus — used for golden eval dataset generation only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Retrieval thresholds
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_N=10
MIN_RERANK_SCORE=-10.0

# Chunking (tokens)
BODY_CHUNK_SIZE=600
BODY_CHUNK_OVERLAP=150
META_CHUNK_SIZE=192

# Freshness
STALENESS_DAYS=30

# BM25 index persistence
BM25_INDEX_DIR=data/bm25_indexes

# Ingestion metadata
INGESTION_META_DIR=data/ingestion_meta
